# ── Gravlytics Environment Variables ──

# General
NODE_ENV=development

# ── ClickHouse ──
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=gravlytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=gravlytics_dev

# ── PostgreSQL ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gravlytics
POSTGRES_USER=gravlytics
POSTGRES_PASSWORD=gravlytics_dev

# ── Redpanda ──
REDPANDA_BROKERS=localhost:9092
REDPANDA_TOPIC_EVENTS=events
REDPANDA_TOPIC_DLQ=events-dlq

# ── Valkey (Redis-compatible) ──
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=

# ── Collector Service ──
COLLECTOR_PORT=8081
COLLECTOR_BATCH_SIZE=1000
COLLECTOR_FLUSH_INTERVAL_MS=2000

# ── Consumer Service ──
CONSUMER_GROUP=gravlytics-consumer
CONSUMER_BATCH_SIZE=1000
CONSUMER_FLUSH_INTERVAL_MS=2000

# ── Query API ──
QUERY_PORT=8082

# ── Auth / JWT ──
JWT_SECRET=change-me-in-production
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# ── OAuth ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── GeoIP ──
GEOIP_DB_PATH=./GeoLite2-City.mmdb

# ── Dashboard (SvelteKit) ──
PUBLIC_COLLECTOR_URL=http://localhost:8081
PUBLIC_QUERY_API_URL=http://localhost:8082
